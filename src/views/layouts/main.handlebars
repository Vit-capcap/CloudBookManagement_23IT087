<!DOCTYPE html>
<html lang="vi">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>CloudBook Management</title>

    <style>

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family:
                Inter,
                Arial,
                Helvetica,
                sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #eef2ff 0%,
                    #f8fafc 50%,
                    #ecfeff 100%
                );

            color: #1e293b;

            min-height: 100vh;
        }

        /* ============================= */
        /* HEADER */
        /* ============================= */

        .navbar {
            background: #111827;
            color: white;

            padding: 18px 5%;

            display: flex;

            align-items: center;

            justify-content: space-between;

            box-shadow:
                0 4px 15px rgba(0, 0, 0, 0.12);
        }

        .brand {
            display: flex;

            align-items: center;

            gap: 12px;
        }

        .brand-icon {
            width: 44px;
            height: 44px;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #6366f1,
                    #06b6d4
                );

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 22px;
        }

        .brand h1 {
            font-size: 20px;
        }

        .brand span {
            color: #94a3b8;

            font-size: 12px;
        }

        .nav-status {
            display: flex;

            align-items: center;

            gap: 8px;

            font-size: 14px;

            color: #cbd5e1;
        }

        .status-dot {
            width: 9px;
            height: 9px;

            border-radius: 50%;

            background: #22c55e;

            box-shadow:
                0 0 10px #22c55e;
        }

        /* ============================= */
        /* MAIN */
        /* ============================= */

        .main-container {
            width: 92%;

            max-width: 1300px;

            margin: 35px auto 60px;
        }

        .page-title {
            margin-bottom: 25px;
        }

        .page-title h2 {
            font-size: 32px;

            color: #0f172a;

            margin-bottom: 7px;
        }

        .page-title p {
            color: #64748b;

            font-size: 15px;
        }

        /* ============================= */
        /* STATISTICS */
        /* ============================= */

        .stats {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 18px;

            margin-bottom: 25px;
        }

        .stat-card {
            background: white;

            border-radius: 18px;

            padding: 22px;

            box-shadow:
                0 8px 30px
                rgba(15, 23, 42, 0.06);

            border:
                1px solid #e2e8f0;
        }

        .stat-top {
            display: flex;

            justify-content: space-between;

            align-items: center;
        }

        .stat-icon {
            width: 45px;
            height: 45px;

            border-radius: 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 20px;

            background: #eef2ff;
        }

        .stat-label {
            color: #64748b;

            font-size: 13px;

            margin-bottom: 8px;
        }

        .stat-value {
            font-size: 25px;

            font-weight: 700;

            color: #0f172a;
        }

        /* ============================= */
        /* CONTENT GRID */
        /* ============================= */

        .content-grid {
            display: grid;

            grid-template-columns:
                360px 1fr;

            gap: 22px;

            align-items: start;
        }

        .card {
            background: white;

            border-radius: 18px;

            padding: 25px;

            border:
                1px solid #e2e8f0;

            box-shadow:
                0 8px 30px
                rgba(15, 23, 42, 0.06);
        }

        .card-title {
            font-size: 18px;

            font-weight: 700;

            margin-bottom: 5px;

            color: #0f172a;
        }

        .card-description {
            color: #64748b;

            font-size: 13px;

            margin-bottom: 22px;
        }

        /* ============================= */
        /* FORM */
        /* ============================= */

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;

            font-size: 13px;

            font-weight: 600;

            margin-bottom: 7px;

            color: #334155;
        }

        .form-group input {
            width: 100%;

            padding: 12px 13px;

            border:
                1px solid #cbd5e1;

            border-radius: 10px;

            outline: none;

            font-size: 14px;

            transition: 0.2s;
        }

        .form-group input:focus {
            border-color: #6366f1;

            box-shadow:
                0 0 0 3px
                rgba(99, 102, 241, 0.12);
        }

        .form-hint {
            font-size: 11px;

            color: #94a3b8;

            margin-top: 5px;
        }

        .btn-primary {
            width: 100%;

            border: none;

            border-radius: 10px;

            padding: 13px;

            color: white;

            font-weight: 700;

            font-size: 14px;

            cursor: pointer;

            background:
                linear-gradient(
                    135deg,
                    #6366f1,
                    #4f46e5
                );

            transition: 0.2s;
        }

        .btn-primary:hover {
            transform: translateY(-1px);

            box-shadow:
                0 8px 18px
                rgba(79, 70, 229, 0.25);
        }

        /* ============================= */
        /* ALERT */
        /* ============================= */

        .alert {
            padding: 14px 18px;

            border-radius: 12px;

            margin-bottom: 20px;

            font-size: 14px;

            display: flex;

            align-items: center;

            gap: 10px;
        }

        .alert-success {
            background: #ecfdf5;

            color: #047857;

            border:
                1px solid #a7f3d0;
        }

        .alert-error {
            background: #fef2f2;

            color: #b91c1c;

            border:
                1px solid #fecaca;
        }

        /* ============================= */
        /* TABLE */
        /* ============================= */

        .table-header {
            display: flex;

            justify-content: space-between;

            align-items: center;

            margin-bottom: 18px;
        }

        .book-count {
            background: #eef2ff;

            color: #4f46e5;

            padding: 6px 11px;

            border-radius: 20px;

            font-size: 12px;

            font-weight: 700;
        }

        .table-wrapper {
            overflow-x: auto;
        }

        table {
            width: 100%;

            border-collapse: collapse;
        }

        th {
            text-align: left;

            padding: 13px 12px;

            font-size: 12px;

            color: #64748b;

            background: #f8fafc;

            border-bottom:
                1px solid #e2e8f0;
        }

        td {
            padding: 15px 12px;

            border-bottom:
                1px solid #f1f5f9;

            font-size: 13px;
        }

        tbody tr {
            transition: 0.15s;
        }

        tbody tr:hover {
            background: #f8fafc;
        }

        .product-code {
            color: #4f46e5;

            font-weight: 700;
        }

        .book-name {
            font-weight: 600;

            color: #0f172a;
        }

        .author {
            color: #64748b;
        }

        .price {
            font-weight: 600;
        }

        .price-after-tax {
            color: #059669;

            font-weight: 700;
        }

        .vat-badge {
            display: inline-block;

            background: #fff7ed;

            color: #c2410c;

            padding: 4px 8px;

            border-radius: 6px;

            font-size: 11px;

            font-weight: 700;
        }

        /* ============================= */
        /* EMPTY */
        /* ============================= */

        .empty-state {
            text-align: center;

            padding: 55px 20px;

            color: #94a3b8;
        }

        .empty-icon {
            font-size: 45px;

            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: #475569;

            margin-bottom: 7px;
        }

        /* ============================= */
        /* FOOTER */
        /* ============================= */

        footer {
            background: #111827;

            color: #94a3b8;

            text-align: center;

            padding: 25px 15px;

            font-size: 13px;
        }

        footer strong {
            color: white;
        }

        .footer-sub {
            margin-top: 7px;

            font-size: 12px;

            color: #64748b;
        }

        /* ============================= */
        /* RESPONSIVE */
        /* ============================= */

        @media (max-width: 1000px) {

            .stats {
                grid-template-columns:
                    repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

        }

        @media (max-width: 600px) {

            .navbar {
                padding: 15px;
            }

            .nav-status {
                display: none;
            }

            .main-container {
                width: 94%;

                margin-top: 25px;
            }

            .page-title h2 {
                font-size: 25px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .card {
                padding: 18px;
            }

        }

    </style>

</head>

<body>

    <!-- ============================= -->
    <!-- NAVBAR -->
    <!-- ============================= -->

    <header class="navbar">

        <div class="brand">

            <div class="brand-icon">
                📚
            </div>

            <div>

                <h1>
                    CloudBook
                </h1>

                <span>
                    Hệ thống quản lý sách
                </span>

            </div>

        </div>

        <div class="nav-status">

            <span class="status-dot"></span>

            Hệ thống đang hoạt động

        </div>

    </header>


    <!-- ============================= -->
    <!-- MAIN CONTENT -->
    <!-- ============================= -->

    <main class="main-container">

        {{{body}}}

    </main>


    <!-- ============================= -->
    <!-- FOOTER -->
    <!-- ============================= -->

    <footer>

        <div>

            Sinh viên:
            <strong>
                Nguyễn Quốc Hoàng
            </strong>

            &nbsp;|&nbsp;

            MSSV:
            <strong>
                23IT087
            </strong>

            &nbsp;|&nbsp;

            VAT:
            <strong>
                11%
            </strong>

        </div>

        <div class="footer-sub">

            CloudBook Management System
            &nbsp;•&nbsp;
            MongoDB Atlas
            &nbsp;•&nbsp;
            Node.js & Express

        </div>

    </footer>

</body>

</html>